#!/bin/sh
# keep the stylesheet URL in sync with its content so browsers and Cloudflare never serve a stale copy
H=$(shasum assets/site.css | cut -c1-10)
sed -i '' "s/site\.css?v=[0-9a-z]*/site.css?v=$H/" index.html 404.html
python3 scripts/build_projects.py >/dev/null
# stamp a build id; pages compare it with version.txt and reload once when a newer build is live
B=$(date +%s)
echo "$B" > version.txt
sed -i '' "s/<meta name=\"build\" content=\"[0-9]*\">/<meta name=\"build\" content=\"$B\">/" index.html 404.html work/*/index.html
git add index.html 404.html work version.txt
# keep sitemap lastmod current
D=$(date +%Y-%m-%d)
sed -i '' "s#<lastmod>[0-9-]*</lastmod>#<lastmod>$D</lastmod>#g" sitemap.xml
DT=$(date +%Y-%m-%dT%H:%M:%S%z | sed 's/\(..\)$/:\1/')
sed -i '' "s#\"dateModified\": \"[^\"]*\"#\"dateModified\": \"$DT\"#" index.html
git add sitemap.xml index.html
