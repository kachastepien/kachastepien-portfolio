#!/bin/sh
# keep the stylesheet URL in sync with its content so browsers and Cloudflare never serve a stale copy
H=$(shasum assets/site.css | cut -c1-10)
sed -i '' "s/site\.css?v=[0-9a-z]*/site.css?v=$H/" index.html 404.html
python3 scripts/build_projects.py >/dev/null
git add index.html 404.html work
